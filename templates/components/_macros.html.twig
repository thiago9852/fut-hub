{# Team Logo Resolver: normaliza caminhos de logo para garantir URLs absolutas #}
{% macro team_logo_src(team) %}
    {% set logo = team.logo|default('')|trim %}
    {% if logo %}
        {% if logo starts with 'http://' or logo starts with 'https://' or logo starts with '/' %}
            {{- logo -}}
        {% elseif logo starts with 'uploads/' %}
            {{- '/' ~ logo -}}
        {% else %}
            {{- '/uploads/teams/' ~ logo -}}
        {% endif %}
    {% elseif team.slug %}
        {{- '/uploads/teams/' ~ team.slug ~ '.svg' -}}
    {% endif %}
{% endmacro %}

{# Team Badge with Logo or Elegant Shield Initial #}
{% macro team_badge(team, size) %}
    {% import _self as self %}
    {% set size = size|default(24) %}
    {% set logoSrc = self.team_logo_src(team)|trim %}
    {% set fontSize = (size * 0.42)|round %}
    
    <span class="team-badge-wrapper" style="display:inline-flex; align-items:center; gap:0.5rem; font-weight:600;">
        {% if logoSrc %}
            <img src="{{ logoSrc }}" alt="{{ team.name }}" style="width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 30 ? '8px' : '6px' }}; object-fit:contain; vertical-align:middle; flex-shrink:0;" onerror="this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='inline-flex';">
            <span style="display:none; align-items:center; justify-content:center; width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 30 ? '8px' : '6px' }}; background:var(--surface-card); border:1px solid var(--line-strong); color:var(--accent); font-size:{{ fontSize }}px; font-weight:800; vertical-align:middle; flex-shrink:0;">{{ team.name|slice(0, 1)|upper }}</span>
        {% else %}
            <span style="display:inline-flex; align-items:center; justify-content:center; width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 30 ? '8px' : '6px' }}; background:var(--surface-card); border:1px solid var(--line-strong); color:var(--accent); font-size:{{ fontSize }}px; font-weight:800; vertical-align:middle; flex-shrink:0;">{{ team.name|slice(0, 1)|upper }}</span>
        {% endif %}
        <span class="team-name-text">{{- team.name -}}</span>
    </span>
{% endmacro %}

{# Standalone Team Crest #}
{% macro team_crest(team, size) %}
    {% import _self as self %}
    {% set size = size|default(48) %}
    {% set logoSrc = self.team_logo_src(team)|trim %}
    {% set fontSize = (size * 0.42)|round %}
    
    {% if logoSrc %}
        <img src="{{ logoSrc }}" alt="{{ team.name }}" style="width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 40 ? '12px' : '8px' }}; object-fit:contain; flex-shrink:0;" onerror="this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='inline-flex';">
        <span style="display:none; align-items:center; justify-content:center; width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 40 ? '12px' : '8px' }}; background:var(--surface-card); border:1px solid var(--line-strong); color:var(--accent); font-size:{{ fontSize }}px; font-weight:800; flex-shrink:0;">{{ team.name|slice(0, 1)|upper }}</span>
    {% else %}
        <span style="display:inline-flex; align-items:center; justify-content:center; width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 40 ? '12px' : '8px' }}; background:var(--surface-card); border:1px solid var(--line-strong); color:var(--accent); font-size:{{ fontSize }}px; font-weight:800; flex-shrink:0;">{{ team.name|slice(0, 1)|upper }}</span>
    {% endif %}
{% endmacro %}

{# Player Avatar #}
{% macro player_avatar(player, size) %}
    {% set size = size|default(32) %}
    <img src="{{ player.photo ?: '/uploads/profile.png' }}" alt="{{ player.name }}" style="width:{{ size }}px; height:{{ size }}px; border-radius:{{ size > 40 ? '10px' : '6px' }}; object-fit:cover; background:var(--surface-card); border:1px solid var(--line); flex-shrink:0;">
{% endmacro %}

{# Match Status Pill #}
{% macro match_status_badge(status) %}
    {% set val = status.value|default(status) %}
    {% if val == 'SCHEDULED' or val == 'AGENDADO' %}
        <span class="badge badge-cyan">Agendado</span>
    {% elseif val == 'FINISHED' or val == 'ENCERRADO' %}
        <span class="badge">Encerrado</span>
    {% elseif val == 'IN_PROGRESS' or val == 'EM_ANDAMENTO' or val == 'AO VIVO' %}
        <span class="badge badge-emerald">Ao Vivo</span>
    {% else %}
        <span class="badge">{{ val }}</span>
    {% endif %}
{% endmacro %}

{% extends 'public/base.html.twig' %}
{% import 'components/_macros.html.twig' as macros %}

{% block title %}Artilharia — {{ championship.name }} — FutHub{% endblock %}

{% block public_body %}
{% include 'public/championship/_tabs.html.twig' %}

<div class="section-header">
    <h3 class="section-title">
        <span class="section-title-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="12 6 15.5 10 14 14.5 10 14.5 8.5 10 12 6"/></svg>
        </span>
        Ranking de Artilheiros
    </h3>
    <span style="color: var(--muted); font-size: 0.8rem;">
        Gols registrados na temporada
    </span>
</div>

{% if topScorers is empty %}
    <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <p>Nenhum gol registrado nesta temporada até o momento.</p>
    </div>
{% else %}
    {# Top 3 Podium showcase #}
    {% if topScorers|length >= 2 %}
        <div class="podium-grid">
            {% for stat in topScorers|slice(0, 3) %}
                <a href="{{ path('public_player_show', {slug: stat.player.slug}) }}" class="podium-card {{ loop.index == 1 ? 'first' : '' }}">
                    <div class="podium-medal">
                        {% if loop.index == 1 %}🥇{% elseif loop.index == 2 %}🥈{% else %}🥉{% endif %}
                    </div>
                    
                    {{ macros.player_avatar(stat.player, 52) }}

                    <div>
                        <div style="font-weight: 800; font-size: 1.05rem; color: #ffffff; margin-bottom: 0.2rem;">
                            {{ stat.player.name }}
                        </div>
                        <div style="font-size: 0.82rem; color: var(--text-secondary);">
                            {{ macros.team_badge(stat.team, 18) }}
                        </div>
                    </div>

                    <div class="podium-goals">
                        <span>{{ stat.count }} {{ stat.count == 1 ? 'Gol' : 'Gols' }}</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {# Full table #}
    <div class="table-container">
        <table class="scorers-table">
            <thead>
                <tr>
                    <th style="width: 44px; text-align: center;">Pos</th>
                    <th>Jogador</th>
                    <th>Clube</th>
                    <th style="width: 90px; text-align: center;">Gols</th>
                </tr>
            </thead>
            <tbody>
                {% for stat in topScorers %}
                    <tr>
                        <td style="text-align: center;">
                            <span class="pos-badge {{ loop.index == 1 ? 'top-1' : (loop.index == 2 ? 'top-2' : (loop.index == 3 ? 'top-3' : '')) }}">
                                {{ loop.index }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('public_player_show', {slug: stat.player.slug}) }}" style="color: #ffffff; font-weight: 700; display: inline-flex; align-items: center; gap: 0.55rem;">
                                {{ macros.player_avatar(stat.player, 24) }}
                                <span>{{ stat.player.name }}</span>
                            </a>
                        </td>
                        <td>
                            <a href="{{ path('public_team_show', {slug: stat.team.slug}) }}" style="color: var(--text-secondary);">
                                {{ macros.team_badge(stat.team, 20) }}
                            </a>
                        </td>
                        <td style="text-align: center;">
                            <span style="font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 800; font-size: 1rem; color: var(--accent);">
                                {{ stat.count }}
                            </span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

{% extends 'public/base.html.twig' %}
{% import 'components/_macros.html.twig' as macros %}

{% block title %}{{ player.name }} — Perfil do Atleta — FutHub{% endblock %}

{% block public_body %}
{% set directGoals = goals + assists %}

{# Player Hero Banner #}
<div class="player-hero">
    {{ macros.player_avatar(player, 72) }}
    <div class="player-details">
        <div style="display:flex; align-items:center; gap:0.45rem; margin-bottom:0.2rem;">
            <span class="badge badge-cyan">Atleta</span>
            <span class="badge badge-emerald">Ativo</span>
        </div>
        <h1>{{ player.name }}</h1>
        <div class="player-meta-tags">
            <div class="meta-pill" style="background:var(--surface-card); padding:0.25rem 0.65rem; border-radius:var(--radius-sm); border:1px solid var(--line); font-size:0.8rem; color:var(--text);">
                <strong style="color:var(--accent);">Posição:</strong> {{ player.position ?: 'Não informada' }}
            </div>
            {% if player.birthDate %}
                <div class="meta-pill" style="background:var(--surface-card); padding:0.25rem 0.65rem; border-radius:var(--radius-sm); border:1px solid var(--line); font-size:0.8rem; color:var(--muted);">
                    Nascimento: {{ player.birthDate|date('d/m/Y') }}
                </div>
            {% endif %}
            <div class="meta-pill" style="background:var(--surface-card); padding:0.25rem 0.65rem; border-radius:var(--radius-sm); border:1px solid var(--line); font-size:0.8rem; color:var(--muted);">
                {{ history|length }} {{ history|length == 1 ? 'Vínculo Registrado' : 'Vínculos Registrados' }}
            </div>
        </div>
    </div>
</div>

{# Player Stats Cards #}
<div class="player-stat-grid">
    <div class="player-stat-card">
        <div class="player-stat-icon goals">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="12 6 15.5 10 14 14.5 10 14.5 8.5 10 12 6"/></svg>
        </div>
        <div class="player-stat-data">
            <strong>{{ goals }}</strong>
            <span>Gols Marcados</span>
        </div>
    </div>
    
    <div class="player-stat-card">
        <div class="player-stat-icon assists">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
        </div>
        <div class="player-stat-data">
            <strong>{{ assists }}</strong>
            <span>Assistências</span>
        </div>
    </div>

    <div class="player-stat-card">
        <div class="player-stat-icon participation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="player-stat-data">
            <strong style="color: var(--accent);">{{ directGoals }}</strong>
            <span>Participações em Gol</span>
        </div>
    </div>

    <div class="player-stat-card">
        <div class="player-stat-icon yellow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/></svg>
        </div>
        <div class="player-stat-data">
            <strong>{{ yellowCards }}</strong>
            <span>Amarelos</span>
        </div>
    </div>

    <div class="player-stat-card">
        <div class="player-stat-icon red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"/></svg>
        </div>
        <div class="player-stat-data">
            <strong>{{ redCards }}</strong>
            <span>Vermelhos</span>
        </div>
    </div>
</div>

{# Estatísticas & Gráficos do Jogador #}
<div class="charts-grid-player">
    {# Chart 1: Estatísticas Individuais (Barra) #}
    <div class="chart-card">
        <h4>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Indicadores Individuais de Desempenho
        </h4>
        <div class="chart-container">
            <canvas id="playerMetricsChart"></canvas>
        </div>
    </div>

    {# Chart 2: Distribuição Ofensiva e Disciplinar (Doughnut) #}
    <div class="chart-card">
        <h4>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Distribuição de Eventos
        </h4>
        <div class="chart-container">
            <canvas id="playerEventsRatioChart"></canvas>
        </div>
    </div>
</div>

{# Career History #}
<div class="section-header">
    <h3 class="section-title">
        <span class="section-title-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3z"/></svg>
        </span>
        Passagens por Clubes
    </h3>
    <span style="color: var(--muted); font-size: 0.8rem;">{{ history|length }} registros</span>
</div>

{% if history is empty %}
    <div class="empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <p>Nenhum vínculo histórico registrado para este atleta.</p>
    </div>
{% else %}
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Clube / Time</th>
                    <th>Temporada</th>
                    <th style="text-align: center; width: 60px;">Camisa</th>
                    <th style="text-align: center; width: 90px;">Status</th>
                </tr>
            </thead>
            <tbody>
                {% for teamPlayer in history %}
                    <tr>
                        <td>
                            <a href="{{ path('public_team_show', {slug: teamPlayer.team.slug}) }}" style="color: #ffffff; font-weight: 700; display: inline-flex; align-items: center; gap: 0.5rem;">
                                {{ macros.team_badge(teamPlayer.team, 22) }}
                            </a>
                        </td>
                        <td style="color: var(--text-secondary);">
                            Temporada {{ teamPlayer.season.name }}
                        </td>
                        <td style="text-align: center;">
                            <span class="shirt-badge">{{ teamPlayer.shirtNumber ?: '-' }}</span>
                        </td>
                        <td style="text-align: center;">
                            <span class="badge badge-emerald" style="font-size: 0.68rem;">Ativo</span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}

{% block extra_javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    var goals = {{ goals }};
    var assists = {{ assists }};
    var yellow = {{ yellowCards }};
    var red = {{ redCards }};

    // 1. Player Metrics Bar Chart
    var ctxMetrics = document.getElementById('playerMetricsChart');
    if (ctxMetrics) {
        new Chart(ctxMetrics, {
            type: 'bar',
            data: {
                labels: ['Gols', 'Assistências', 'Amarelos', 'Vermelhos'],
                datasets: [{
                    label: 'Total',
                    data: [goals, assists, yellow, red],
                    backgroundColor: ['#a3e635', '#38bdf8', '#fbbf24', '#f87171'],
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#8b9bb4', font: { family: 'Plus Jakarta Sans', size: 11 } }
                    },
                    y: {
                        grid: { color: 'rgba(255,255,255,0.06)' },
                        ticks: { color: '#8b9bb4', stepSize: 1, font: { family: 'Space Grotesk', size: 11 } },
                        beginAtZero: true
                    }
                }
            }
        });
    }

    // 2. Player Events Ratio (Doughnut Chart)
    var ctxRatio = document.getElementById('playerEventsRatioChart');
    if (ctxRatio) {
        var totalEvents = goals + assists + yellow + red;
        new Chart(ctxRatio, {
            type: 'doughnut',
            data: {
                labels: totalEvents > 0 ? ['Gols', 'Assistências', 'Amarelos', 'Vermelhos'] : ['Sem registros'],
                datasets: [{
                    data: totalEvents > 0 ? [goals, assists, yellow, red] : [1],
                    backgroundColor: totalEvents > 0 ? ['#a3e635', '#38bdf8', '#fbbf24', '#f87171'] : ['rgba(255,255,255,0.1)'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#cbd5e1', font: { family: 'Plus Jakarta Sans', size: 11 }, padding: 12 }
                    }
                },
                cutout: '65%'
            }
        });
    }
});
</script>
{% endblock %}

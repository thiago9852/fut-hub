{% extends 'admin/base.html.twig' %}

{% block title %}{{ season.id ? 'Editar' : 'Nova' }} temporada — Futebol Local{% endblock %}

{% block admin_body %}
<h1>{{ season.id ? 'Editar temporada' : 'Nova temporada' }}</h1>
<div class="card">
    {{ form_start(form) }}
        {{ form_row(form.championship) }}
        {{ form_row(form.name) }}
        {{ form_row(form.year) }}
        {{ form_row(form.status) }}
        <div class="form-actions">
            <button type="submit" class="btn">Salvar</button>
            <a href="{{ path('admin_season_index') }}" class="btn secondary">Cancelar</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}

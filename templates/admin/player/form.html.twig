{% extends 'admin/base.html.twig' %}

{% block title %}{{ player.id ? 'Editar' : 'Novo' }} jogador — Futebol Local{% endblock %}

{% block admin_body %}
<h1>{{ player.id ? 'Editar jogador' : 'Novo jogador' }}</h1>
<div class="card">
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.slug) }}
        {{ form_row(form.birthDate) }}
        {{ form_row(form.position) }}
        {{ form_row(form.status) }}
        <div class="form-actions">
            <button type="submit" class="btn">Salvar</button>
            <a href="{{ path('admin_player_index') }}" class="btn secondary">Cancelar</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}

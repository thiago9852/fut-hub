{% extends 'admin/base.html.twig' %}

{% block title %}Configurações — Futebol Local{% endblock %}

{% block admin_body %}
<h1>Configurações</h1>

<h2 style="font-size:1rem; color: var(--muted); text-transform: uppercase; letter-spacing:.03em;">Organização</h2>
<div class="card">
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.city) }}
        {{ form_row(form.state) }}
        <div class="form-actions">
            <button type="submit" class="btn">Salvar</button>
        </div>
    {{ form_end(form) }}
</div>

<h2 style="font-size:1rem; color: var(--muted); text-transform: uppercase; letter-spacing:.03em; margin-top:2rem;">Token de API</h2>
<div class="card">
    <p style="color: var(--muted); font-size:.9rem; margin-top:0;">
        Usado na integração com a planilha Excel e em chamadas diretas à API
        (<code>Authorization: Bearer TOKEN</code>). É pessoal — vinculado à
        sua conta e à organização "{{ organization.name }}".
    </p>
    <code style="display:block; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: .75rem 1rem; word-break: break-all; color: var(--accent);">{{ app.user.apiToken ?? '(nenhum token gerado ainda)' }}</code>
    <form method="post" action="{{ path('admin_settings_regenerate_token') }}" style="margin-top: 1rem;" onsubmit="return confirm('Gerar um novo token invalida o atual imediatamente. Continuar?');">
        <input type="hidden" name="_token" value="{{ csrf_token('regenerate-api-token') }}">
        <button type="submit" class="btn secondary">Gerar novo token</button>
    </form>
</div>
{% endblock %}

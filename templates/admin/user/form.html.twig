{% extends 'admin/base.html.twig' %}

{% block title %}{{ userEntity.id ? 'Editar' : 'Novo' }} usuário — Futebol Local{% endblock %}

{% block admin_body %}
<h1>{{ userEntity.id ? 'Editar usuário' : 'Novo usuário' }}</h1>
<div class="card">
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.role) }}
        {{ form_row(form.status) }}
        {{ form_row(form.plainPassword) }}
        <div class="form-actions">
            <button type="submit" class="btn">Salvar</button>
            <a href="{{ path('admin_user_index') }}" class="btn secondary">Cancelar</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
